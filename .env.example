# Copy to .env.local for local development. Never commit real credentials.

# Runtime connection: restricted role, subject to row-level security.
DATABASE_URL=postgres://edubridge_app:edubridge_app_local@localhost:5432/edubridge_dev

# Migrations and seeding: schema owner role. Not used by the running application.
MIGRATION_DATABASE_URL=postgres://edubridge_owner:edubridge_owner_local@localhost:5432/edubridge_dev

# Public origin used in links we send (invitations). Required in production.
APP_URL=http://localhost:3000

# Encrypts two-step verification secrets at rest. 32 random bytes, base64.
# Generate your own for local use (any OS):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse a key across environments.
MFA_ENCRYPTION_KEY=

# Email (Brevo) and SMS (Arkesel). Leave unset in development: messages are written to .dev-mailbox.jsonl.
# In production both must be set, or messages fail (they are never silently dropped).
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=EduBridge
# Validate requests with Brevo without sending (X-Sib-Sandbox: drop).
BREVO_SANDBOX=false
ARKESEL_API_KEY=
# Registered Arkesel sender ID, 11 characters or fewer.
SMS_SENDER_ID=EduBridge
ARKESEL_SANDBOX=false

# Mobile Money: "mock" (test mode, no money moves) or "none". Unset: mock in development, none in production.
MOBILE_MONEY_PROVIDER=
# The mock posts signed callbacks to APP_URL after a delay. Set "false" to rely on the worker's checks.
MOBILE_MONEY_MOCK_CALLBACKS=
MOBILE_MONEY_MOCK_CALLBACK_DELAY_MS=3000
# How often the worker settles Mobile Money prompts (callbacks and status checks).
MOBILE_MONEY_POLL_MS=15000
# How often the worker looks for report-card print runs left over (they normally start straight away).
REPORT_CARD_POLL_MS=15000

# Platform administrators must use two-step verification unless this is "false".
PLATFORM_MFA_REQUIRED=true
