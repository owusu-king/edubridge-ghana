# Copy to .env.local for local development. Never commit real credentials.

# Runtime connection: restricted role, subject to row-level security.
DATABASE_URL=postgres://edubridge_app:edubridge_app_local@localhost:5432/edubridge_dev

# Migrations and seeding: schema owner role. Not used by the running application.
MIGRATION_DATABASE_URL=postgres://edubridge_owner:edubridge_owner_local@localhost:5432/edubridge_dev

# Public origin used in links we send (invitations). Required in production.
APP_URL=http://localhost:3000

# How many proxies (load balancer, CDN) append to X-Forwarded-For in front of the app. The client's address
# for rate limits and audit is that many entries from the right. Default 1; unset locally.
TRUSTED_PROXY_HOPS=
# Public trust page (/trust): one sentence each, shown only when set, e.g. where data is hosted and how it is
# backed up. State only what the deployment really does.
TRUST_HOSTING=
TRUST_BACKUPS=

# Encrypts secrets at rest: two-step verification seeds, platform API keys and record-signing keys.
# 32 random bytes, base64. Generate your own for local use (any OS):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse a key across environments. Losing it locks every two-step user out and loses the keys
# stored under Admin, Integrations: keep it in the secrets manager and its backup.
MFA_ENCRYPTION_KEY=
# Only while rotating MFA_ENCRYPTION_KEY: the old key, so values sealed with it still open until
# `npm run keys:rotate -- <platform admin email>` has sealed them again. Remove afterwards.
MFA_ENCRYPTION_KEY_PREVIOUS=

# Email (Brevo) and SMS (Arkesel). Leave unset in development: messages are written to .dev-mailbox.jsonl.
# In production both must be set, or messages fail (they are never silently dropped).
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=EduBridge
# Validate requests with Brevo without sending (X-Sib-Sandbox: drop).
BREVO_SANDBOX=false
ARKESEL_API_KEY=
# Registered Arkesel sender ID, 11 characters or fewer.
SMS_SENDER_ID=EduBridge
ARKESEL_SANDBOX=false

# Mobile Money: "paystack", "mock" (test mode, no money moves) or "none". Unset: Paystack test mode in
# development when PAYSTACK_TEST_SECRET_KEY is set, else the mock; none in production.
MOBILE_MONEY_PROVIDER=
# Paystack (D-06). Test mode: put your Paystack test secret key (sk_test_...) here; locally it is used
# automatically. Never commit a real key. A live key (sk_live_) also needs PAYSTACK_ALLOW_LIVE=true, set
# only once real payments are approved, and PAYSTACK_CUSTOMER_EMAIL_DOMAIN (a domain EduBridge controls).
# In the Paystack dashboard, set the webhook URL to {APP_URL}/api/v1/mobile-money/callbacks/paystack
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_ALLOW_LIVE=
PAYSTACK_CUSTOMER_EMAIL_DOMAIN=
# The mock posts signed callbacks to APP_URL after a delay. Set "false" to rely on the worker's checks.
MOBILE_MONEY_MOCK_CALLBACKS=
MOBILE_MONEY_MOCK_CALLBACK_DELAY_MS=3000
# How often the worker settles Mobile Money prompts (callbacks and status checks).
MOBILE_MONEY_POLL_MS=15000
# How often the worker looks for report-card print runs left over (they normally start straight away).
REPORT_CARD_POLL_MS=15000

# Platform administrators must use two-step verification unless this is "false".
PLATFORM_MFA_REQUIRED=true

# Transfer Passport signing keys are managed by platform staff under Admin, Integrations (generated,
# stored encrypted, rotated; retired keys keep verifying earlier records). These variables are an
# optional fallback: an Ed25519 key (PKCS#8, base64 DER or PEM) and its id, and earlier public keys as a
# JSON object of key id to SPKI. Outside production a fixed development key is used when nothing is set.
RECORD_SIGNING_KEY=
RECORD_SIGNING_KEY_ID=
RECORD_SIGNING_PUBLIC_KEYS=

# AI gateway (R5-4): off by default. Platform staff choose the provider, model and key under Admin,
# Integrations (free and local providers first: Ollama needs no key; Groq's free tier needs one). These are
# only fallbacks when no key is stored there: AI_API_KEY for OpenAI-compatible providers, ANTHROPIC_API_KEY
# for Anthropic (paid: only with the founder's approval and the data-protection review).
AI_API_KEY=
ANTHROPIC_API_KEY=

# Web push to parents' phones (optional; the parent view hides the switch without it). Generate a pair with:
#   node --input-type=module -e "import {generateVAPIDKeys} from 'web-push'; console.log(generateVAPIDKeys())"
# Keep it stable once phones have subscribed. In development, pushes are written to .dev-mailbox.jsonl.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services: mailto:support@your-domain (defaults to APP_URL).
VAPID_SUBJECT=

# WhatsApp Business (optional, WAB-01): Meta WhatsApp Cloud API from EduBridge's own number. Without the
# token and number id, families are not offered WhatsApp and messages go by SMS. In development, WhatsApp
# messages are written to .dev-mailbox.jsonl. See the deployment guide, section 10, for the templates.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v24.0
WHATSAPP_TEMPLATE_LANGUAGE=en

# Paying EduBridge invoices online (SUB-04): EduBridge's own Paystack account, not the schools' one. In
# development a test mode is used (no money moves). Live keys also need EDUBRIDGE_PAYSTACK_ALLOW_LIVE=true.
EDUBRIDGE_PAYSTACK_SECRET_KEY=
EDUBRIDGE_PAYSTACK_ALLOW_LIVE=
EDUBRIDGE_PAYSTACK_CURRENCIES=GHS

# The public landing page (/). "Try the demo school" appears only when DEMO_SCHOOL_SLUG names a demo school that
# has its visitor account (npm run demo:visitor -- --slug=...). The visit is view-only and lasts two hours.
DEMO_SCHOOL_SLUG=
# The introduction video, served by EduBridge itself: put the file in public/ and give its path, e.g.
# /landing/intro.mp4 (and a still for before it plays). Unset: production shows no video section.
LANDING_VIDEO=
LANDING_VIDEO_POSTER=
# Optional ways to reach EduBridge, shown beside "Book a visit". WhatsApp: the number with its country code.
LANDING_PHONE=
LANDING_WHATSAPP=
LANDING_EMAIL=
